# syntax=docker/dockerfile:1

# Multi-stage build for melostore-server (single binary service).
#
#   docker build -f Dockerfile.service -t melostore-server:latest .

# ---- build ----
FROM rust:1-bookworm AS builder

ARG SERVICE_BIN=melostore-server
WORKDIR /build

COPY Cargo.toml README.md ./
COPY Cargo.lock* ./
COPY src ./src
COPY apps ./apps

RUN cargo build --release -p "${SERVICE_BIN}" \
    && cp "target/release/${SERVICE_BIN}" /build-bin \
    && rm -rf target /usr/local/cargo/registry /usr/local/cargo/git

# ---- runtime ----
FROM debian:bookworm-slim

ARG SERVICE_BIN=melostore-server
ARG SERVICE_PORT=8080

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build-bin /usr/local/bin/service

USER 10001:10001

ENV BIND_ADDR=0.0.0.0:${SERVICE_PORT} \
    RUST_LOG=info,tower_http=info

EXPOSE ${SERVICE_PORT}

CMD ["service"]
